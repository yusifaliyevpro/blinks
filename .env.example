# Upstash Redis over REST.
# Create a free database at https://upstash.com and copy the REST credentials from its dashboard.
KV_REST_API_URL="https://your-db.upstash.io"
KV_REST_API_TOKEN="your-rest-token"

# Salt for key derivation. It is public (not secret), but it must never change.
# Pick one long random string and keep it forever. It has to be identical in
# every environment, or your saved links become impossible to open.
# Generate one with:  openssl rand -hex 32
NEXT_PUBLIC_KDF_SALT="pick-a-long-random-string-and-keep-it-forever"

# Optional. Set to "true" to let browser and third party password managers use the password field. Off by default.
NEXT_PUBLIC_ALLOW_PASSWORD_MANAGERS="false"
